# ========================================================
# ReadFlow 环境变量配置模板
# 纯净、无感、极简的通用电子书自动化捕获与分发引擎
# ========================================================

# --------------------------------------------------------
# 1. 意图捕获源 (支持豆瓣与 Goodreads，二者可任选其一或同时启用)
# --------------------------------------------------------
# 豆瓣用户数字 ID 或个性域名 (例如: douban.com/people/{DOUBAN_USER_ID}/)
DOUBAN_USER_ID=your_douban_id

# Goodreads 用户 ID (例如: goodreads.com/user/show/{GOODREADS_USER_ID})
GOODREADS_USER_ID=

# 侦听检查间隔（秒），默认 600 秒（10分钟）
CHECK_INTERVAL_SECONDS=600

# --------------------------------------------------------
# 2. 邮件分发配置 (带 RFC 2047 规范编码附件，直接进入电纸书/邮箱)
# --------------------------------------------------------
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_smtp_app_password
# 接收书籍的邮箱 (汉王/Kindle/163/QQ/个人常用邮箱)
TARGET_EMAIL=your_reader@163.com

# --------------------------------------------------------
# 3. 群晖 NAS / 本地 Calibre 藏书库配置 (可选)
# --------------------------------------------------------
# 若 Calibre 运行在远程群晖 NAS，配置 SSH Host 别名（如 ~/.ssh/config 中的 nas）
NAS_SSH_HOST=nas
# 群晖 NAS 或本地 Calibre 书库根目录 (用于定位已有原档与统计藏书量)
NAS_CALIBRE_ROOT=/volume1/homes/placid/Books/00-Calibre
# Calibre metadata.db SQLite 数据库绝对路径 (用于 0 毫秒查重)
NAS_CALIBRE_DB=/volume1/homes/placid/Books/00-Calibre/metadata.db
# 自动入库收件箱目录 (新下载书籍自动存入此目录供 Calibre-Web 自动导入)
NAS_INBOX_DIR=/volume1/homes/placid/Books/05-inbox
# 最新推送归档目录 (可选，推送到设备的副本另存路径)
NAS_PUSH_DIR=/volume1/homes/placid/Books/05-inbox/最新推送

# --------------------------------------------------------
# 4. 多书源检索凭据 (瀑布流优先级: Calibre ➔ Z-Lib ➔ Anna's ➔ Libgen)
# --------------------------------------------------------
# Z-Library 账号与密码 (支持自动客户端 SHA-1 PoW 算力破解)
ZLIB_EMAIL=your_zlib_account@example.com
ZLIB_PASSWORD=your_zlib_password
# Z-Library User ID 与 User Key (可选，若已获取可直接填入提速)
ZLIB_USER_ID=
ZLIB_USER_KEY=
# Z-Library 可用镜像域名 (默认 z-library.sk)
ZLIB_DOMAIN=z-library.sk

# 本地代理配置 (如果国内网络访问 Z-Lib / Anna's / Goodreads 受限，填入本地 HTTP/SOCKS 代理)
# 例如 Clash / V2Ray: http://127.0.0.1:7897
HTTP_PROXY=

# Anna's Archive (安娜档案: 免登元搜索备用源，默认开启)
ENABLE_ANNAS_ARCHIVE=true

# Library Genesis (Libgen: 英文原版/学术专著兜底，默认开启)
ENABLE_LIBGEN=true
