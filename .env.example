# ========================================================
# ReadFlow 环境变量配置模板
# 纯净、无感、极简的通用电子书捕获与分发引擎
# ========================================================

# 1. 意图捕获源 (支持豆瓣与 Goodreads，二者可任选其一或同时启用)
# 豆瓣用户数字 ID 或个性域名 (例如: douban.com/people/{DOUBAN_USER_ID}/)
DOUBAN_USER_ID=your_douban_id
# Goodreads 用户 ID (例如: goodreads.com/user/show/{GOODREADS_USER_ID})
GOODREADS_USER_ID=

# 侦听检查间隔（秒），默认 600 秒（10分钟）
CHECK_INTERVAL_SECONDS=600

# 2. 邮件分发配置 (带 RFC 2047 规范编码附件，直接进入电纸书/邮箱)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_smtp_app_password
# 接收书籍的邮箱 (汉王/Kindle/163/个人常用邮箱)
TARGET_EMAIL=your_reader@163.com

# 3. Calibre 藏书库配置 (可选，若不配置则只通过邮件/本地下发)
# 本地或 NAS 上的 Calibre metadata.db 路径 (用于查重)
CALIBRE_DB_PATH=/books/metadata.db
# Calibre 书库根目录 (用于定位已有原档)
CALIBRE_LIBRARY_PATH=/books
# 自动入库收件箱目录 (新书会自动放入此目录供 Calibre-Web 导入)
CALIBRE_INBOX_DIR=/inbox

# 4. 多书源检索凭据
# Z-Library 账号凭据 (首选源)
ZLIB_EMAIL=your_zlib_account@example.com
ZLIB_PASSWORD=your_zlib_password

# Anna's Archive (安娜档案: 免登录开源元搜索备用源，默认开启)
ENABLE_ANNAS_ARCHIVE=true

# Library Genesis (Libgen: 英文原版/学术专著兜底，默认开启)
ENABLE_LIBGEN=true
