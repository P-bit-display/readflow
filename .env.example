# ========================================================
# Douban2Reader 环境变量配置模板
# 复制本文件为 .env 并填入你自己的配置
# ========================================================

# 1. 豆瓣配置
# 你的豆瓣用户数字ID或个性域名 (打开豆瓣个人主页看网址：https://www.douban.com/people/{DOUBAN_USER_ID}/)
DOUBAN_USER_ID=your_douban_id
# 检查间隔时间（秒），默认 600 秒（10分钟）
CHECK_INTERVAL_SECONDS=600

# 2. 邮件推送配置 (用于推送 EPUB 附件到电子纸/常用邮箱)
# 推荐使用 Gmail (启用应用密码) 或 163/QQ 邮箱 (启用客户端授权码)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_smtp_app_password
# 接收电子书的邮箱 (汉王/Kindle/个人常用邮箱)
TARGET_EMAIL=your_reader_email@163.com

# 3. Calibre 藏书库配置 (可选，若不配置则只通过邮件/本地下发)
# 本地或 NAS 上的 Calibre metadata.db 路径
CALIBRE_DB_PATH=/books/metadata.db
# Calibre 书库根目录 (用于查找已有文件)
CALIBRE_LIBRARY_PATH=/books
# 新书自动入库收件箱目录
INBOX_DIR=/inbox

# 4. 资源下载引擎 (Z-Library 凭证)
ZLIB_EMAIL=your_zlib_account@example.com
ZLIB_PASSWORD=your_zlib_password

# 5. Telegram 消息通知 (可选)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
